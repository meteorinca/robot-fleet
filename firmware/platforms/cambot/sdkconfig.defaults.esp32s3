# sdkconfig.defaults.esp32s3
# Applied automatically by IDF when IDF_TARGET=esp32s3

# ── Console ──────────────────────────────────────────────────────────────────
# S3 has native USB-JTAG/Serial (no UART0 needed for console)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash ────────────────────────────────────────────────────────────────────
# XIAO ESP32S3 Sense has 8MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table for 8MB flash
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota_8mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota_8mb.csv"

# ── PSRAM (OPI PSRAM — required for camera frame buffers) ────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ── Size optimizations ────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Log: keep INFO level in development (camera init messages are helpful)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Networking ────────────────────────────────────────────────────────────────
# MJPEG stream needs more simultaneous connections
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535

# WiFi throughput: Increase AMPDU block-ack window from 6 to 32
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16

# FreeRTOS: 1000 Hz tick rate (1ms tick instead of 10ms for lower jitter and higher responsiveness)
CONFIG_FREERTOS_HZ=1000

# TCP retransmission: lower from 1500ms default to 300ms for fast recovery on local WiFi
CONFIG_LWIP_TCP_RTO_TIME=300

# Pin LWIP task to Core 0 (WiFi core) so Core 1 is dedicated to camera DMA & stream
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY=0x0

# HTTP server: allow larger sends for MJPEG frames
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=n

# ── Misc ─────────────────────────────────────────────────────────────────────
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
